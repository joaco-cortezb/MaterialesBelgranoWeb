# Web pública Materiales Belgrano — variables de entorno
# Copiá este archivo a `.env.local` y completá con credenciales reales.

# Supabase (Settings → API). La web sólo LEE con la anon key + RLS.
NEXT_PUBLIC_SUPABASE_URL="https://PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOi...anon-key..."

# Server-only: registra los clics a WhatsApp (tabla WhatsappClick). Nunca NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOi...service-role-key..."

# URL canónica de la web (metadataBase, sitemap, robots, JSON-LD).
NEXT_PUBLIC_SITE_URL="https://materialesbelgrano.com"

# Bearer de POST /api/revalidate. Tiene que ser el MISMO que en el panel.
REVALIDATE_SECRET="cambiame-por-un-secreto-largo"

# Upstash Redis REST — rate limiting distribuido (opcional; sin esto usa memoria).
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Contenedor de Google Tag Manager (GA4 adentro). Vacío = no se carga ningún tag.
NEXT_PUBLIC_GTM_ID=""
