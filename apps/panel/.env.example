# Panel de administración Materiales Belgrano — variables de entorno
# Copiá este archivo a `.env.local` y completá con credenciales reales.

# Postgres de Supabase (Settings → Database → Connection string).
# DATABASE_URL: pooler (puerto 6543) para el runtime. DIRECT_URL: directa (5432) para migraciones.
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# Supabase — Auth + Storage (Settings → API).
NEXT_PUBLIC_SUPABASE_URL="https://PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOi...anon-key..."

# Service role: SOLO en el server del panel. Nunca en el cliente ni en la web.
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOi...service-role-key..."

# Bucket público de Storage donde van logos y fotos.
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET="media"

# URL de la web pública (para el webhook de revalidación y los links "ver en la web").
PUBLIC_WEB_URL="https://materialesbelgrano.com"
# URL propia del panel (redirects de auth).
PANEL_URL="http://localhost:3001"

# Webhook de revalidación: opcional; si falta usa PUBLIC_WEB_URL/api/revalidate.
REVALIDATE_WEBHOOK_URL=""
# Tiene que ser el MISMO secreto que en la web.
REVALIDATE_SECRET="cambiame-por-un-secreto-largo"

# Upstash Redis REST — rate limiting distribuido (opcional; sin esto usa memoria).
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
