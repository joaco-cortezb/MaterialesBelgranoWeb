// Panel = fuente de verdad del esquema (Prisma migrate).
// La web pública sólo LEE estas tablas (anon key + RLS); los clics a WhatsApp
// los inserta server-side con la service role.

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────
// Auth
// ─────────────────────────────────────────────────────────────

/// Sólo quien tiene una fila acá puede entrar al panel (acceso por invitación).
model Profile {
  id        String   @id // = auth.users.id
  email     String   @unique
  fullName  String?
  role      Role     @default(ADMIN)
  createdAt DateTime @default(now())
}

enum Role {
  ADMIN
  EDITOR
}

// ─────────────────────────────────────────────────────────────
// Contenido administrable
// ─────────────────────────────────────────────────────────────

model Brand {
  id         String   @id @default(cuid())
  name       String
  slug       String   @unique
  logo       String? // URL pública en Storage
  catalogUrl String
  rubroSlug  String? // slug de `Category`; null = sin solución
  order      Int      @default(0)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([active, order])
}

/// Imagen fija de la web, identificada por `key` (ver IMAGE_SLOTS en packages/shared).
model ImageSlot {
  key       String   @id
  url       String
  alt       String
  position  String? // object-position "x% y%"
  updatedAt DateTime @updatedAt
}

/// Foto del carrusel de portada de una página (`page`: inicio | marcas | nosotros), en orden.
model HeroSlide {
  id        String   @id @default(cuid())
  page      String   @default("inicio")
  url       String
  alt       String
  position  String   @default("50% 50%")
  order     Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([page, active, order])
}

/// Una solución (rubro) de la web: página propia, card del carrusel del inicio
/// y agrupador de marcas (`Brand.rubroSlug`).
model Category {
  id              String   @id @default(cuid())
  slug            String   @unique
  name            String
  summary         String
  description     String[] // párrafos
  subcategories   String[]
  faqs            Json     @default("[]") // [{ question, answer }]
  image           String?
  imageAlt        String?
  imagePosition   String   @default("50% 50%")
  whatsappMessage String   @default("")
  seoTitle        String?
  seoDescription  String?
  order           Int      @default(0)
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([active, order])
}

/// Banner del inicio (`key`: lugar donde se muestra). Con `url`, todo el banner es un link.
model Banner {
  key       String   @id
  title     String
  text      String   @default("")
  image     String   @default("")
  url       String   @default("")
  active    Boolean  @default(true)
  updatedAt DateTime @updatedAt
}

model WhatsappNumber {
  id        String   @id @default(cuid())
  label     String
  phone     String // sólo dígitos con código de país (formato wa.me)
  message   String   @default("")
  audience  Audience @default(GENERAL)
  order     Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clicks WhatsappClick[]

  @@index([active, order])
}

enum Audience {
  GENERAL
  EMPRESAS
}

/// Clave-valor JSON para contenido suelto (video del inicio, texto de Nosotros).
model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

/// Un clic a WhatsApp desde la web (lo registra `/go/whatsapp/[source]`).
model WhatsappClick {
  id          String          @id @default(cuid())
  source      String
  numberId    String?
  number      WhatsappNumber? @relation(fields: [numberId], references: [id], onDelete: SetNull)
  referrer    String?
  visitorHash String?
  createdAt   DateTime        @default(now())

  @@index([source, createdAt])
  @@index([createdAt])
}
